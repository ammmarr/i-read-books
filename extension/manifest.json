{
  "manifest_version": 3,
  "name": "I read — Substack time",
  "short_name": "I read",
  "version": "1.4.0",
  "description": "Counts the time you actively read on Substack, keeps your highlights and notes there, and adds it all to I read; posts the quotes you share from I read as Substack Notes.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "I read · Substack time",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js", "annotate.js"],
      "run_at": "document_idle"
    }
  ]
}
